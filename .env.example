# Copy this file to `.env` and fill in your keys.
# The app runs without them — when Gemini is unavailable or out of quota,
# Groq is tried automatically, then Jarvislabs Token Factory, then the
# bundled deterministic agents.

# Primary provider: Gemini (free tier ~20 requests/day on gemini-3.6-flash)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Fallback provider: Groq (groq.com, OpenAI-compatible, fast inference)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Deep-dive provider: Jarvislabs Token Factory (jarvislabs.ai).
# Runs the Stage-8 deep dive first and is the last link of the LLM chain.
# jarvislabs.ai → dashboard → API keys. OpenAI-compatible at models.jarvislabs.net/v1
JARVISLABS_API_KEY=your-jarvislabs-api-key-here
# Any model from the Token Factory catalog: glm-5.3, glm-5.3-flash, deepseek-v4-flash, ...
JARVISLABS_MODEL=glm-5.3

PORT=3001